# Porta em que o servidor de sinalizacao escuta.
# O Render injeta PORT automaticamente em producao; localmente use 3001.
PORT=3001

# Origem permitida para conexoes Socket.io/CORS.
# Em producao, defina a URL do seu frontend no Vercel (ex: https://seu-app.vercel.app).
# Use "*" apenas em desenvolvimento local.
CORS_ORIGIN=*
